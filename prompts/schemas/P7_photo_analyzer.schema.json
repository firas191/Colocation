{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flatshare:prompts:P7_photo_analyzer:v1",
  "title": "P7 photo analyzer output v1: a short open description plus the same closed lists, every field answered (spec 9.4 baseline)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "room_type",
    "beds",
    "bed_kinds",
    "furniture",
    "appliances",
    "bathroom_fixtures",
    "windows",
    "natural_light",
    "condition",
    "condition_signs",
    "furnished",
    "readable_text",
    "people_visible"
  ],
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "room_type": {
      "type": "string",
      "enum": [
        "bedroom",
        "living_room",
        "kitchen",
        "bathroom",
        "dining_room",
        "studio",
        "hallway",
        "balcony_or_terrace",
        "office",
        "other_room",
        "not_a_room"
      ]
    },
    "beds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "bed_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "single",
          "double",
          "bunk",
          "sofa_bed"
        ]
      },
      "maxItems": 4
    },
    "furniture": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wardrobe",
          "chest_of_drawers",
          "nightstand",
          "desk",
          "chair",
          "sofa",
          "armchair",
          "table",
          "shelves"
        ]
      },
      "maxItems": 9
    },
    "appliances": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fridge",
          "oven",
          "hob",
          "microwave",
          "washing_machine",
          "dishwasher",
          "tv",
          "air_conditioning",
          "radiator"
        ]
      },
      "maxItems": 9
    },
    "bathroom_fixtures": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "shower",
          "bathtub",
          "toilet",
          "washbasin"
        ]
      },
      "maxItems": 4
    },
    "windows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "natural_light": {
      "type": "string",
      "enum": [
        "good",
        "some",
        "none"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "good",
        "fair",
        "poor"
      ]
    },
    "condition_signs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "damp_or_mould",
          "cracks_or_peeling",
          "stains",
          "damaged_floor",
          "unfinished_works"
        ]
      },
      "maxItems": 5
    },
    "furnished": {
      "type": "string",
      "enum": [
        "yes",
        "partly",
        "no"
      ]
    },
    "readable_text": {
      "type": "boolean"
    },
    "people_visible": {
      "type": "boolean"
    }
  }
}
