{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flatshare:prompts:P1_router",
  "title": "P1 router output",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "language", "script", "jurisdiction_hint", "confidence", "needs_clarification", "clarifying_question"],
  "properties": {
    "intent": {"type": "string", "enum": ["search_listings", "post_listing", "legal_question", "generate_document", "report_problem", "smalltalk_or_unsupported"]},
    "language": {"type": "string", "enum": ["fr", "en", "ar", "aeb", "de", "es", "it", "mixed", "other"]},
    "script": {"type": "string", "enum": ["latin", "arabic", "mixed", "other"]},
    "jurisdiction_hint": {"type": ["string", "null"], "enum": ["TN", "FR", "GB", "other", null]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_clarification": {"type": "boolean"},
    "clarifying_question": {"type": ["string", "null"], "maxLength": 300}
  }
}
