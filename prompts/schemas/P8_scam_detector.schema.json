{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flatshare:prompts:P8_scam_detector",
  "title": "P8 scam detector output (text signals with evidence, prices written in the text; the score is computed in code)",
  "type": "object",
  "additionalProperties": false,
  "required": ["signals", "prices_in_text"],
  "properties": {
    "signals": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "quote", "evidence"],
        "properties": {
          "type": {"type": "string", "enum": ["off_platform_payment", "advance_payment", "owner_abroad", "urgency", "external_contact"]},
          "quote": {"type": "string", "maxLength": 160},
          "evidence": {"type": "string", "maxLength": 120}
        }
      }
    },
    "prices_in_text": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["amount", "currency", "context"],
        "properties": {
          "amount": {"type": "number", "minimum": 0},
          "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
          "context": {"type": "string", "maxLength": 60}
        }
      }
    }
  }
}