.env
*.env.local
reports/env-check.txt
reports/**/*.secret
node_modules/
__pycache__/
.pytest_cache/
.venv/
*.pyc
/tmp/
secrets/
.secrets.local
flatshare.bundle

# fetched source texts and raw bytes (third-party content, re-fetchable; DECISIONS D-044)
kb/packs/*/documents/

# detector and speech models are downloaded at build or run time (models.lock), not committed
services/*/models/

# website build output and test reports (web/, platform P1)
web/.next/
web/test-results/
web/playwright-report/
web/*.tsbuildinfo
web/.env*
web/public/map/maplibre-gl-worker.mjs

# Map tiles cut on the owner's PC (scripts/windows/map.ps1): large, rebuilt from the Protomaps build, not committed
geo/tiles/*.pmtiles
geo/tiles/tools/

# database dumps and the photo store copied by scripts/windows/backup.ps1 (personal data; never committed)
backups/
