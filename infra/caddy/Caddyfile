# Reverse proxy for the flatshare backend.
# Public surface: /v1/* only, rewritten to n8n production webhooks (/webhook/v1/*).
# Everything else (n8n editor, REST API, test webhooks) is not reachable here.
# n8n answers some failures itself (unknown route, unparsable body, its own
# database down, unexpected workflow error) without our envelope; those
# answers are recognised by the missing X-Request-Id header and replaced.
{
	admin off
	auto_https off
	servers {
		max_header_size 32KB
	}
}

:{$PROXY_PORT:8080} {
	log {
		output stdout
		format json
	}
	# 1 MiB. Declared sizes are refused up front with 413; a chunked body that
	# grows past the limit is cut by request_body (older Caddy versions then
	# report it as an upstream error, see docs/FAILURES.md F-009).
	request_body {
		max_size 1MiB
	}
	@too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 1048576`
	handle @too_large {
		header Content-Type application/json
		header X-Request-Id {http.request.uuid}
		respond `{"request_id":"{http.request.uuid}","error":{"code":"PAYLOAD_TOO_LARGE","message":"Request body is too large","details":[]}}` 413
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@api path /v1/*
	handle @api {
		rewrite * /webhook{uri}
		reverse_proxy {$N8N_UPSTREAM:n8n:5678} {
			header_up -X-Forwarded-Host
			@n8n_not_found {
				status 404
				header !X-Request-Id
			}
			handle_response @n8n_not_found {
				header Content-Type application/json
				header X-Request-Id {http.request.uuid}
				respond `{"request_id":"{http.request.uuid}","error":{"code":"NOT_FOUND","message":"Route not found","details":[]}}` 404
			}
			@n8n_bad_request {
				status 400 415 422
				header !X-Request-Id
			}
			handle_response @n8n_bad_request {
				header Content-Type application/json
				header X-Request-Id {http.request.uuid}
				respond `{"request_id":"{http.request.uuid}","error":{"code":"VALIDATION_FAILED","message":"Request body is not valid JSON","details":[]}}` 422
			}
			@n8n_unavailable {
				status 502 503 504
				header !X-Request-Id
			}
			handle_response @n8n_unavailable {
				header Content-Type application/json
				header X-Request-Id {http.request.uuid}
				respond `{"request_id":"{http.request.uuid}","error":{"code":"UPSTREAM_UNAVAILABLE","message":"A backend dependency is unavailable","details":[]}}` 503
			}
			@n8n_error {
				status 5xx
				header !X-Request-Id
			}
			handle_response @n8n_error {
				header Content-Type application/json
				header X-Request-Id {http.request.uuid}
				respond `{"request_id":"{http.request.uuid}","error":{"code":"INTERNAL","message":"Internal error","details":[]}}` 500
			}
		}
	}

	handle {
		header Content-Type application/json
		header X-Request-Id {http.request.uuid}
		respond `{"request_id":"{http.request.uuid}","error":{"code":"NOT_FOUND","message":"Route not found","details":[]}}` 404
	}

	handle_errors {
		header Content-Type application/json
		header X-Request-Id {http.request.uuid}
		@err_too_large expression {err.status_code} == 413
		handle @err_too_large {
			respond `{"request_id":"{http.request.uuid}","error":{"code":"PAYLOAD_TOO_LARGE","message":"Request body is too large","details":[]}}` 413
		}
		@upstream expression {err.status_code} in [502, 503, 504]
		handle @upstream {
			respond `{"request_id":"{http.request.uuid}","error":{"code":"UPSTREAM_UNAVAILABLE","message":"A backend dependency is unavailable","details":[]}}` 503
		}
		handle {
			respond `{"request_id":"{http.request.uuid}","error":{"code":"INTERNAL","message":"Internal error","details":[]}}` 500
		}
	}
}
