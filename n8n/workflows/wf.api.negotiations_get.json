        "jsCode": "// Route contract for this endpoint (read by wf.gateway.auth).\nconst route = {\"method\": \"GET\", \"template\": \"/v1/negotiations/:id\", \"require_user\": true, \"idempotent\": false, \"required_consents\": [\"terms\", \"privacy\"], \"roles\": []};\nconst item = $input.first();\nreturn [{ json: { ...item.json, t0: Date.now(), route }, binary: item.binary }];\n"
