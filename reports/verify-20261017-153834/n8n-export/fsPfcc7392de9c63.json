{"updatedAt":"2026-10-17T15:15:31.043Z","createdAt":"2026-10-17T14:53:39.812Z","id":"fsPfcc7392de9c63","name":"wf.ops.retention","description":null,"active":true,"isArchived":false,"nodes":[{"id":"15b2de9b-562d-599f-b981-24a1eeb9a468","name":"Every day","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[0,0],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"30 3 * * *"}]}}},{"id":"c53b7430-6618-57ea-83d5-e566db8ce52f","name":"Retention","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[220,0],"parameters":{"operation":"executeQuery","query":"select app.retention_run(null) as r","options":{}},"credentials":{"postgres":{"id":"fsCredPgWorker01","name":"Flatshare DB (n8n_worker)"}},"alwaysOutputData":false,"retryOnFail":true,"maxTries":3,"waitBetweenTries":5000},{"id":"042249ee-b509-558d-9f9b-e3a2634c6dab","name":"File jobs","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[440,0],"parameters":{"operation":"executeQuery","query":"select app.media_deletions_take(20) as jobs, (select jsonb_object_agg(key, value #>> '{}') from app.settings where key in ('services.media_url', 'media.photo_url_ttl_s')) as cfg","options":{}},"credentials":{"postgres":{"id":"fsCredPgWorker01","name":"Flatshare DB (n8n_worker)"}},"alwaysOutputData":false},{"id":"f7ec5bb3-d1f5-507a-aa47-3c5e1e9196b7","name":"Each job","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// wf.ops.retention > \"Each job\" (platform P10, D-109): one item per file-deletion job (keys kept in the job by the\n// erasure, backend spec 13.6), for the Media service's delete call. No job: no item, nothing else runs.\nconst row = $input.first().json || {};\nconst cfg = row.cfg || {};\nconst url = `${String(cfg['services.media_url'] || '').replace(/\\/+$/, '')}/v1/storage/delete`;\nreturn (row.jobs || []).filter((j) => Array.isArray(j.keys)).map((j) => ({ json: { job_id: j.job_id, url,\n  body: { keys: j.keys.slice(0, 100) }, empty: j.keys.length === 0 } }));\n"}},{"id":"e9cd3fbc-54ab-5d82-9cd3-43848380c16e","name":"Delete files","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[880,0],"parameters":{"method":"POST","url":"={{ $json.url }}","options":{"timeout":"={{ 60000 }}","redirect":{"redirect":{"followRedirects":true,"maxRedirects":5}},"response":{"response":{"fullResponse":true,"neverError":true,"responseFormat":"json"}}},"sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify($json.body) }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"onError":"continueRegularOutput","credentials":{"httpHeaderAuth":{"id":"fsCredSvcToken01","name":"Compute services token"}}},{"id":"cc280c74-c948-521a-b6e7-323e28832278","name":"Results","type":"n8n-nodes-base.code","typeVersion":2,"position":[1100,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// wf.ops.retention > \"Results\": which jobs the Media service did (a job without keys is done at once); failed ones go\n// back to the queue, up to five attempts (app.media_deletions_done).\nconst jobs = $('Each job').all().map((i) => i.json);\nconst res = $input.all().map((i) => i.json || {});\nconst out = jobs.map((j, k) => {\n  const r = res[k] || {};\n  const ok = j.empty || (r.statusCode === 200 && r.body && Number.isInteger(r.body.deleted));\n  return { job_id: j.job_id, ok, deleted: ok && r.body ? r.body.deleted || 0 : 0 };\n});\nreturn [{ json: { results: JSON.stringify(out) } }];\n"}},{"id":"aaaf973e-925d-5aa5-bb38-2b0f3ccfec65","name":"Mark done","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1320,0],"parameters":{"operation":"executeQuery","query":"select app.media_deletions_done($1::jsonb) as r","options":{"queryReplacement":"={{ [ $json.results ] }}"}},"credentials":{"postgres":{"id":"fsCredPgWorker01","name":"Flatshare DB (n8n_worker)"}},"alwaysOutputData":fals