===== wait for TEI (multilingual-e5-large; first start downloads the model, max 45 min) =====
command: docker compose @files --profile test run --rm --no-deps tests python -c @"
import time, httpx
t0 = time.time()
while time.time() - t0 < 2700:
    try:
        r = httpx.get('http://tei:80/health', timeout=5)
        if r.status_code == 200:
            print('TEI healthy after', round(time.time() - t0), 's'); raise SystemExit(0)
    except httpx.HTTPError:
        pass
    time.sleep(10)
print('TEI not healthy after 45 min'); raise SystemExit(1)
"@
