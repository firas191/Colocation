{"updatedAt":"2026-10-18T00:44:09.446Z","createdAt":"2026-10-12T06:51:07.451Z","id":"fsListingApply01","name":"wf.listing.apply","description":null,"active":true,"isArchived":false,"nodes":[{"id":"dc85babb-e897-5fcc-a73b-7116bff161e3","name":"Start","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[0,0],"parameters":{"inputSource":"passthrough"}},{"id":"e2750527-8060-53f8-b457-96a492812cce","name":"Apply","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[220,0],"parameters":{"operation":"executeQuery","query":"select case when $3 <> '' then app.listing_change_confirm($1::uuid, $2::uuid, app.try_uuid($3)) else app.listing_apply_changes($1::uuid, $2::uuid, $4::jsonb) end as r","options":{"queryReplacement":"={{ [ $json.user_id, $json.listing_id, $json.change_id || '', JSON.stringify($json.changes || {}) ] }}"}},"credentials":{"postgres":{"id":"fsCredPgWorker01","name":"Flatshare DB (n8n_worker)"}},"alwaysOutputData":false},{"id":"a07b582f-2e53-554f-9ea9-47bd477d1674","name":"Next steps","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// wf.listing.apply > \"Next steps\": after the change is written, what is left to do outside the database: delete\n// the removed photos from storage (Media service), embed the listing again when its place changed or it was just\n// published (D-088).\nconst r = $input.first().json.r || {};\nconst ok = r.ok === true;\nconst keys = ok && Array.isArray(r.deleted_keys) ? r.deleted_keys : [];\nconst cfg = r.embed || {};\nreturn [{ json: { r, delete: keys.length > 0, embed: ok && r.reembed === true && !!r.embed_text,\n  delete_url: `${String(r.media_url || '').replace(/\\/+$/, '')}/v1/storage/delete`, delete_body: { keys },\n  model: cfg['ollama.embed_model'] || 'bge-m3',\n  embed_url: `${String(cfg['ollama.base_url'] || '').replace(/\\/+$/, '')}/api/embed`,\n  embed_body: { model: cfg['ollama.embed_model'] || 'bge-m3', input: [r.embed_text || ''], truncate: true,\n                keep_alive: cfg['llm.keep_alive'] || '10m' } } }];\n"}},{"id":"ad883662-455f-5bc2-842c-07d790e5c177","name":"Delete photos?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[660,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"2e81b2b5-c9c9-5ee6-8a5e-cc6664b1e4d1","leftValue":"={{ $json.delete }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"looseTypeValidation":true,"options":{}}},{"id":"6a2ae7fb-f0d5-5210-bc74-903295625bcc","name":"Delete photos","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[880,-100],"parameters":{"method":"POST","url":"={{ $('Next steps').first().json.delete_url }}","options":{"timeout":"={{ 30000 }}","redirect":{"redirect":{"followRedirects":true,"maxRedirects":5}},"response":{"response":{"fullResponse":true,"neverError":true,"responseFormat":"json"}}},"sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify($('Next steps').first().json.delete_body) }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"onError":"continueRegularOutput","credentials":{"httpHeaderAuth":{"id":"fsCredSvcToken01","name":"Compute services token"}}},{"id":"93c5489e-b21e-5ca8-9ae3-8bba3e0bace2","name":"Embed?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1100,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"2f79a0bc-ffc7-5759-b1b7-c7c5e380b52b","leftValue":"={{ $('Next steps').first().json.embed }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"looseTypeValidation":true,"options":{}}},{"id":"16a71b67-87f3-5263-90cf-cb0f0bf82737","name":"Embed listing","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1320,-100],"parameters":{"method":"POST","url":"={{ $('Next steps').first().json.embed_url }}","options":{"timeout":"={{ 60000 }}","redirect":{"redirect":{"followRedirects":true,"maxRedirects":5}},"response":{"response":{"fullResponse":true,"neverError":true,"responseFormat":"json"}}},"sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify($('Next steps').first().json.embed_body) }}"},"onError":"continueRegularOutput"},{"id":"d772906d-c9b9-5874-8322-6cba77a74bca","name":"Embedding rows","type":"n8n-nodes-base.code","typeVersion":2,"position":[1540,-100],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// wf.listing.apply > \"Embedding rows\": Ollama answer -> rows for app.store_listing_embeddings. A failed embedding\n// leaves the listing as it is; the embed job fills it later.\nconst n = $('Next steps').first().json;\nconst res = $input.first().json || {};\nlet b = res.body !== undefined ? res.body : res;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nconst v = (b && b.embeddings && b.embeddings[0]) || null;\nif (!Array.isArray(v) || v.length !== 1024) return [{ json: { skip: true } }];\nreturn [{ json: { skip: false, params: [n.model, JSON.stringify([{ id: n.r.listing_id, v: `[${v.join(',')}]` }])] } }];\n"}},{"id":"de8a3a78-9f38-5938-b253-d64e896b4d29","name":"Store vector?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1760,-100],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"49a82ec0-09e3-582e-bcae-9da88398bbbf","leftValue":"={{ !$json.skip }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"looseTypeValidation":true,"options":{}}},{"id":"c2c3567f-1d48-5d03-9d30-b55c1b67ecac","name":"Store vector","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1980,-150],"parameters":{"operation":"executeQuery","query":"select app.store_listing_embeddings($1, $2::jsonb) as stored","options":{"queryReplacement":"={{ $json.params }}"}},"credentials":{"postgres":{"id":"fsCredPgWorker01","name":"Flatshare DB (n8n_worker)"}},"alwaysOutputData":false,"onError":"continueRegularOutput"},{"id":"81e0a0c6-9fb9-581c-9712-ee0a908b3458","name":"Result","type":"n8n-nodes-base.code","typeVersion":2,"position":[2200,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// wf.listing.apply > \"Result\": the change as written, what the storage deletion and the new embedding did.\nconst n = $('Next steps').first().json;\nconst r = n.r || {};\nconst tryJson = (name) => { try { return $(name).first().json; } catch (e) { return null; } };\nconst del = n.delete ? tryJson('Delete photos') : null;\nconst emb = n.embed ? tryJson('Store vector') : null;\nconst pub = r.publication || null;\nreturn [{ json: { ok: r.ok === true, found: r.found !== false, listing_id: r.listing_id || null, status: r.status || null,\n  diff: r.diff || [], errors: r.errors || [],\n  publication: pub ? { published: !!pub.published, reason: pub.reason || null, missing: pub.missing || [] } : null,\n  photos_deleted_from_storage: n.delete ? (del && del.statusCode === 200 ? (n.delete_body.keys || []).length : 0) : 0,\n  embedded: n.embed ? !!(emb && emb.stored !== undefined) : null } }];\n"}}],"connections":{"Start":{"main":[[{"node":"Apply","type":"main","index":0}]]},"Apply":{"main":[[{"node":"Next steps","type":"main","index":0}]]},"Next steps":{"main":[[{"node":"Delete photos?","type":"main","index":0}]]},"Delete photos?":{"main":[[{"node":"Delete photos","type":"main","index":0}],[{"node":"Embed?","type":"main","index":0}]]},"Delete photos":{"main":[[{"node":"Embed?","type":"main","index":0}]]},"Embed?":{"main":[[{"node":"Embed listing","type":"main","index":0}],[{"node":"Result","type":"main","index":0}]]},"Embed listing":{"main":[[{"node":"Embedding rows","type":"main","index":0}]]},"Embedding rows":{"main":[[{"node":"Store vector?","type":"main","index":0}]]},"Store vector?":{"main":[[{"node":"Store vector","type":"main","index":0}],[{"node":"Result","type":"main","index":0}]]},"Store vector":{"main":[[{"node":"Result","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","errorWorkflow":"fsOpsErrorHndl01","saveDataSuccessExecution":"none","saveDataErrorExecution":"all","saveManualExecutions":true,"callerPolicy":"workflowsFromSameOwner"},"staticData":null,"meta":null,"nodeGroups":[],"pinData":{},"versionId":"4a823948-2aca-4d80-a48c-4b5b89d96922","activeVersionId":"4a823948-2aca-4d80-a48c-4b5b89d96922","versionCounter":1,"triggerCount":0,"sourceWorkflowId":null,"tags":[{"updatedAt":"2026-10-04T11:18:45.742Z","createdAt":"2026-10-04T11:18:45.742Z","id":"BHBJa93meZDzc5M9","name":"intake"}],"shared":[{"updatedAt":"2026-10-12T06:51:07.451Z","createdAt":"2026-10-12T06:51:07.451Z","role":"workflow:owner","workflowId":"fsListingApply01","projectId":"aBS6kQipeRFY40Th","project":{"updatedAt":"2026-10-01T00:07:51.079Z","createdAt":"2026-09-29T22:50:52.542Z","id":"aBS6kQipeRFY40Th","name":"firas bk <firasbenkhellifa@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"329da9e1-eed5-4e8e-9409-2e9511c7b997"}}],"versionMetadata":{"name":null,"description":null}}