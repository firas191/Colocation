{"updatedAt":"2026-10-05T00:59:04.548Z","createdAt":"2026-09-29T22:51:10.076Z","id":"fsOpsErrorHndl01","name":"wf.ops.error_handler","description":null,"active":true,"isArchived":false,"nodes":[{"id":"2e815401-4d70-57cb-ba3e-e77d1d937ac6","name":"Error Trigger","type":"n8n-nodes-base.errorTrigger","typeVersion":1,"position":[0,0],"parameters":{}},{"id":"4e6e0209-8354-5488-acbe-acfc11939db8","name":"Build record","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// wf.ops.error_handler > \"Build record\"\n// Input from the Error Trigger. Keeps only what is needed to find the failure:\n// no input data, which may contain personal data.\nconst e = $input.first().json;\nconst ex = e.execution || {};\nconst wf = e.workflow || {};\nconst err = ex.error || e.trigger?.error || {};\nreturn [{ json: {\n  workflow: String(wf.name || wf.id || 'unknown'),\n  n8n_execution_id: ex.id != null ? String(ex.id) : null,\n  error: `${err.name || 'Error'}: ${String(err.message || 'unknown error').slice(0, 500)} (node: ${ex.lastNodeExecuted || 'unknown'}, mode: ${ex.mode || 'unknown'})`,\n} }];\n"}},{"id":"38246c2d-bd42-50d4-8333-702ccfb72edd","name":"Record failure","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[440,0],"parameters":{"operation":"executeQuery","query":"insert into ai.executions (request_id, workflow, n8n_execution_id, status, finished_at, error) values (gen_random_uuid(), $1, $2, 'failed', now(), $3) returning id","options":{"queryReplacement":"={{ [ $json.workflow, $json.n8n_execution_id, $json.error ] }}"}},"credentials":{"postgres":{"id":"fsCredPgWorker01","name":"Flatshare DB (n8n_worker)"}},"alwaysOutputData":false,"onError":"stopWorkflow"}],"connections":{"Error Trigger":{"main":[[{"node":"Build record","type":"main","index":0}]]},"Build record":{"main":[[{"node":"Record failure","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","saveDataSuccessExecution":"all","saveDataErrorExecution":"all","saveManualExecutions":true,"callerPolicy":"workflowsFromSameOwner"},"staticData":null,"meta":null,"nodeGroups":[],"pinData":{},"versionId":"c941bbec-f92f-4d73-8226-129ced315d6b","activeVersionId":"c941bbec-f92f-4d73-8226-129ced315d6b","versionCounter":2,"triggerCount":0,"sourceWorkflowId":null,"tags":[{"updatedAt":"2026-09-29T22:51:10.076Z","createdAt":"2026-09-29T22:51:10.076Z","id":"ULq9nlNSl8DOnlM8","name":"ops"}],"shared":[{"updatedAt":"2026-09-29T22:51:10.076Z","createdAt":"2026-09-29T22:51:10.076Z","role":"workflow:owner","workflowId":"fsOpsErrorHndl01","projectId":"aBS6kQipeRFY40Th","project":{"updatedAt":"2026-10-01T00:07:51.079Z","createdAt":"2026-09-29T22:50:52.542Z","id":"aBS6kQipeRFY40Th","name":"firas bk <firasbenkhellifa@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"329da9e1-eed5-4e8e-9409-2e9511c7b997"}}],"versionMetadata":{"name":null,"description":null}}