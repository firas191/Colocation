# Copy to .env (never commit .env). scripts/windows/setup.ps1 or scripts/setup-env.sh
# generate every secret below with a cryptographic random generator.
# Values must be hex or URL-safe characters (they are passed through shells and URLs).

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_PASSWORD=
FLATSHARE_DB=flatshare
N8N_DB=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=
# role used by n8n workflows (service role, bypasses RLS)
N8N_WORKER_DB_PASSWORD=
# role reserved for a future API layer (RLS applies)
API_USER_DB_PASSWORD=

# --- n8n ---------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
# 1 = also import test-only workflows (wf.test.fail). Keep 0 outside tests.
N8N_IMPORT_TEST_WORKFLOWS=0

# --- Object storage (Garage, S3 API) ----------------------------------------
S3_BUCKET=flatshare-media
# access key id must look like GK + 24 hex characters, secret 64 hex characters
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=

# --- Compute services (text, media, asr) -----------------------------------
# Shared secret n8n sends in X-Internal-Token (spec 5.4 item 4)
INTERNAL_SERVICE_TOKEN=
# Base URL that clients use for presigned uploads (the proxy); the signature covers its host
S3_PUBLIC_ENDPOINT=http://localhost:8080

# --- Models --------------------------------------------------------------------
# Containerised Ollama (default). To use Ollama installed on Windows instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
EMBED_MODEL=bge-m3
# Optional, only if the owner provides one later (not used in this phase)
CLOUD_LLM_API_KEY=

# --- Proxy ---------------------------------------------------------------------
PROXY_BIND=127.0.0.1
PROXY_PORT=8080

# --- Queue mode (profile "queue", phase 9) ------------------------------------
REDIS_PASSWORD=

# --- Telegram channel (D-079; docs/RUNBOOK.md "Telegram bot") -------------------
# The token @BotFather gives you. Empty = no bot (the relay stays idle). Never commit it.
TELEGRAM_BOT_TOKEN=
ADMIN_ALERT_CHAT_ID=
